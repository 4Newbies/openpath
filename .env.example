# Copy to .env and change the values. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_DB=openpath
POSTGRES_USER=openpath
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433

# --- API ---
API_PORT=4000
# Used when running the API outside Docker (npm run dev in backend/).
# Leave empty in development to use an in-memory store.
DATABASE_URL=postgres://openpath:change-me@localhost:5433/openpath
# Comma-separated list of web origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Rate limit per IP address: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS.
# Learners in one training centre often share one IP address, and one learner
# makes about 15 requests, so 1000 per 15 minutes is about 60 learners. Raise it
# for bigger groups; 0 turns the limit off.
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000
BODY_LIMIT=32kb
# The flows folder: one question file per flow; answers are validated against it.
# FLOWS_DIR=../frontend/public/questions
# Key partner platforms send to create or update jobs (POST /v1/jobs) as
# "Authorization: Bearer <key>". Leave empty in development; in production
# POST /v1/jobs is off until a key is set.
JOBS_API_KEY=
# Number of reverse proxies in front of the API (for correct rate limiting by IP).
TRUST_PROXY=0

# --- Speech-to-text (optional) ---
# Learners who choose "I want to speak my answers" get the browser's own speech
# recogniser by default (free; in Chrome it sends audio to Google). Set a provider
# to have the API turn speech into text instead, for the languages it lists.
# Audio is held in memory for one request and never stored or logged.
# none | addis | azure | selfhosted
SPEECH_PROVIDER=none
# Languages to offer, as form language codes; "code=locale" sets the locale.
# Defaults: addis "am"; azure and selfhosted "am,en,ar".
# SPEECH_LANGUAGES=am,en,ar=ar-SA
# The name learners see in the consent question ("... sent over the internet to <label>").
# Defaults: "Addis Scribe", "Microsoft Azure Speech", or the self-hosted server's host.
# SPEECH_PROVIDER_LABEL=
# SPEECH_MAX_BYTES=1048576
# SPEECH_TIMEOUT_MS=15000
# Voice answers per IP address per RATE_LIMIT_WINDOW_MS (0 = no extra limit).
SPEECH_RATE_LIMIT_MAX=300

# SPEECH_PROVIDER=addis
ADDIS_SCRIBE_API_URL=
ADDIS_SCRIBE_API_KEY=

# SPEECH_PROVIDER=azure (a Speech resource: its key and region, e.g. eastus)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# SPEECH_PROVIDER=selfhosted: an OpenAI-compatible Whisper server, e.g.
# http://whisper:8000 (POST /v1/audio/transcriptions). The key is optional.
SPEECH_SELFHOSTED_URL=
SPEECH_SELFHOSTED_API_KEY=
SPEECH_SELFHOSTED_MODEL=whisper-1

# --- Tests ---
# Set to also run the API tests against Postgres (not only the in-memory store).
# Must be a separate database whose name ends in _test: the tests empty its tables.
# It is created automatically on the same server if missing.
# TEST_DATABASE_URL=postgres://openpath:change-me@localhost:5433/openpath_test
