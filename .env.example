# Copy to .env and change the values. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_DB=openpath
POSTGRES_USER=openpath
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433

# --- API ---
API_PORT=4000
# Used when running the API outside Docker (npm run dev in backend/).
# Leave empty in development to use an in-memory store.
DATABASE_URL=postgres://openpath:change-me@localhost:5433/openpath
# Comma-separated list of web origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Rate limit per IP address: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS.
# Learners in one training centre often share one IP address, and one learner
# makes about 15 requests, so 1000 per 15 minutes is about 60 learners. Raise it
# for bigger groups; 0 turns the limit off.
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000
BODY_LIMIT=32kb
# The flows folder: one question file per flow; answers are validated against it.
# FLOWS_DIR=../frontend/public/questions
# Key partner platforms send to create or update jobs (POST /v1/jobs) as
# "Authorization: Bearer <key>". Leave empty in development; in production
# POST /v1/jobs is off until a key is set.
JOBS_API_KEY=
# Number of reverse proxies in front of the API (for correct rate limiting by IP).
TRUST_PROXY=0

# --- Tests ---
# Set to also run the API tests against Postgres (not only the in-memory store).
# Must be a separate database whose name ends in _test: the tests empty its tables.
# It is created automatically on the same server if missing.
# TEST_DATABASE_URL=postgres://openpath:change-me@localhost:5433/openpath_test
