# ==============================================================================
# OpenPath Server Configuration
# WCAG 2.2 AA Accessible Registration & Voice-Assisted Platform
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://openpath_user:openpath_secret@localhost:5432/openpath_db?schema=public
DB_MODE=auto

# Addis Scribe STT (Speech-to-Text) - Addis Assistant
ADDIS_SCRIBE_API_URL=https://api.addisassistant.com/api/v1/scribe/transcribe
ADDIS_SCRIBE_API_KEY=your_addis_key_here

# Addis Voices TTS (Text-to-Speech) - Addis Assistant
ADDIS_TTS_API_URL=https://api.addisassistant.com/api/v1/voice/generations
ADDIS_TTS_API_KEY=your_addis_key_here
ADDIS_TTS_DEFAULT_VOICE=am-hamen
