# ==============================================================================
# OpenPath Server Configuration
# WCAG 2.2 AA Accessible Registration & Voice-Assisted Platform
# ==============================================================================

# Server Network
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 1. Primary Relational Database (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://openpath_user:openpath_secret@localhost:5432/openpath_db?schema=public

# Database Provider (postgresql | sqlite | memory)
DB_MODE=postgresql

# ------------------------------------------------------------------------------
# 2. Amharic AI & Voice Models Configuration
# ------------------------------------------------------------------------------

# A. Amharic Speech-to-Text (STT) - Addis Scribe
# Recommended starting point: Addis Scribe API
ADDIS_SCRIBE_API_URL=https://api.addisscribe.et/v1/transcribe
ADDIS_SCRIBE_API_KEY=your_addis_scribe_api_key_here
# Fallback STT: Local Whisper-Amharic / Browser Speech Recognition
STT_FALLBACK_PROVIDER=whisper_amharic

# B. Amharic Text-to-Speech (TTS) - Azure Ameha & MMS-TTS
# Azure Ameha Neural Voice: am-ET-AmehaNeural (Male), am-ET-MekdesNeural (Female)
AZURE_SPEECH_KEY=your_azure_speech_resource_key_here
AZURE_SPEECH_REGION=eastus
AZURE_AMHARIC_VOICE=am-ET-AmehaNeural

# Meta MMS-TTS (Massively Multilingual Speech - Amharic: mms-tts-amh)
MMS_TTS_ENDPOINT=http://localhost:8001/tts/amh
MMS_TTS_ENABLED=true

# Audio Storage & Prompts Cache
VOICE_AUDIO_CACHE_DIR=./cache/audio
MAX_AUDIO_UPLOAD_SIZE_MB=10
